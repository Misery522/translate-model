include LICENSE THIRD_PARTY_NOTICES.md
include README.md CONTRIBUTING.md CODE_OF_CONDUCT.md SUPPORT.md
include PRIVACY.md SECURITY.md THREAT_MODEL.md
include pyproject.toml uv.lock .python-version
include requirements.txt requirements-dev.txt
include .env.example .gitignore .gitattributes .editorconfig
include check_environment.ps1
include data/glossary.example.json
include scripts/audit_publication.py scripts/verify_distributions.py
recursive-include tests *.py
recursive-include yijing *.py
recursive-include yijing_api *.py
include scripts/export_openapi.py
include web/package.json web/package-lock.json web/openapi.json web/tsconfig.json
include web/vite.config.ts web/index.html web/README.md
recursive-include web/src *.ts *.tsx *.js *.css
recursive-include web/public *.svg *.webmanifest
recursive-include web/scripts *.mjs
recursive-include docs *.md
recursive-include .github *.yml *.md
global-exclude __pycache__ *.py[cod] *.log
exclude data/glossary.json
