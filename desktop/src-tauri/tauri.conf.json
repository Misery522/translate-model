{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "译境文字宠物",
  "version": "0.4.0-alpha.1",
  "identifier": "io.github.misery522.yijing",
  "build": {
    "frontendDist": "../../web/dist",
    "beforeDevCommand": "npm --prefix ../web run build",
    "beforeBuildCommand": "npm --prefix ../web run build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [{
      "label": "main",
      "create": false,
      "title": "译境 · 文字宠物",
      "url": "index.html?view=pet",
      "width": 360,
      "height": 540,
      "minWidth": 300,
      "minHeight": 360,
      "decorations": false,
      "transparent": false,
      "alwaysOnTop": true,
      "skipTaskbar": true,
      "resizable": true,
      "visible": true,
      "devtools": false,
      "dragDropEnabled": false,
      "incognito": true
    }],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; form-action 'none'; frame-src 'none'",
      "capabilities": ["main"],
      "dangerousDisableAssetCspModification": false
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico", "icons/icon.png"],
    "windows": { "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true } }
  }
}
